# 이 파일을 복사해 이름을 .env 로 바꾸고 값을 채우세요.
# .env 는 절대 커밋하지 않습니다. (.gitignore 로 막혀 있음)

# ----- DB (팀 Docker MariaDB) -----
# 프로그램은 관리자(root)가 아닌 아래 앱 전용 계정으로 접속합니다. 값은 각자 아무거나 정하면 됨
DB_HOST=localhost
# 수업용 MariaDB(3306)·다른 프로젝트(3307)와 겹치지 않게 3308 사용
DB_PORT=3308
DB_NAME=stocknews
DB_USERNAME=
DB_PASSWORD=
# Docker MariaDB 관리자(root) 비밀번호. 앱은 이 계정을 쓰지 않음
MARIADB_ROOT_PASSWORD=

# ----- KIS 한국투자증권 Open API (각자 본인 키) -----
KIS_APP_KEY=
KIS_APP_SECRET=

# ----- 로그인 토큰 서명 키 (백엔드) -----
# 영문·숫자로 32자 이상 아무 값. 내 PC에서만 쓰므로 팀원과 같을 필요 없음
JWT_SECRET=

# ----- AI 파트 -----
OPENAI_API_KEY=
# NAVER API HUB 뉴스 검색 (네이버 클라우드 플랫폼에서 발급)
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=
DART_API_KEY=
