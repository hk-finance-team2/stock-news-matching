# 이 파일을 복사해 이름을 .env 로 바꾸고 값을 채우세요.
# .env 는 절대 커밋하지 않습니다. (.gitignore 로 막혀 있음)

# ----- DB (MariaDB, 앱 전용 계정 사용 / root 금지) -----
DB_HOST=localhost
DB_PORT=3306
DB_NAME=stocknews
DB_USERNAME=
DB_PASSWORD=

# ----- KIS 한국투자증권 Open API (각자 본인 키) -----
KIS_APP_KEY=
KIS_APP_SECRET=

# ----- 로그인 토큰 서명 키 (백엔드) -----
JWT_SECRET=

# ----- AI 파트 -----
OPENAI_API_KEY=
DART_API_KEY=
