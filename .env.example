# 이 파일을 복사해 이름을 .env 로 바꾸고 값을 채우세요.
# .env 는 절대 커밋하지 않습니다. (.gitignore 로 막혀 있음)

# ----- DB (팀 Docker MariaDB) -----
# 프로그램은 관리자(root)가 아닌 아래 앱 전용 계정으로 접속합니다. 값은 각자 아무거나 정하면 됨
DB_HOST=localhost
# 수업용 MariaDB(3306)·다른 프로젝트(3307)와 겹치지 않게 3308 사용
DB_PORT=3308
DB_NAME=stocknews
DB_USERNAME=
DB_PASSWORD=
# Docker MariaDB 관리자(root) 비밀번호. 앱은 이 계정을 쓰지 않음
MARIADB_ROOT_PASSWORD=

# ----- KIS 한국투자증권 Open API (각자 본인 키, 실시간 시세 확장 ①② · 1차 시연 범위 밖) -----
# 키가 없으면 비워 두고 KIS_ENABLED=false 그대로 (서버는 지금과 같음). 켜는 법: docs/setup.md 13절
KIS_APP_KEY=
KIS_APP_SECRET=
KIS_ENABLED=false

# ----- 로그인 토큰 서명 키 (백엔드) -----
# 영문·숫자로 32자 이상 아무 값. 내 PC에서만 쓰므로 팀원과 같을 필요 없음
JWT_SECRET=

# ----- 예시 기사 (화면 개발용, 선택) -----
# 진짜 AI 데이터(db/ai-data)는 이 줄 없이도 기본으로 들어갑니다.
# 예시 기사([예시] 10건)까지 보려면 아래 줄 맨 앞의 # 을 지우고 서버를 다시 켜세요. 발표용 PC에서는 켜지 않습니다. (docs/setup.md 2절)
# FLYWAY_LOCATIONS=classpath:db/migration,classpath:db/ai-data,classpath:db/sample

# ----- AI 파트 -----
OPENAI_API_KEY=
# NAVER API HUB 뉴스 검색 (네이버 클라우드 플랫폼에서 발급)
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=
DART_API_KEY=
# 백엔드가 AI 서버(FastAPI) "다시 생성"을 부를 때 쓰는 비밀값. 아무 긴 값, 백엔드와 같은 .env 를 씀
# 비워 두면 "다시 생성" 버튼만 503 AI_NOT_CONFIGURED (다른 화면은 그대로)
AI_INTERNAL_TOKEN=
# AI 서버 주소. gradlew bootRun 으로 켠 백엔드가 씀 (없으면 http://localhost:8000)
# AI_SERVER_URL=http://localhost:8000
# LLM 하루 비용 상한(달러, 추정치 기준). 넘으면 그날 요약을 멈춤. 없으면 2
# LLM_DAILY_USD=2
# Docker 로 켠 백엔드가 씀 (없으면 같은 Docker 안의 ai-api). AI 서버를 내 PC에서 직접 켰다면 http://host.docker.internal:8000
# AI_SERVER_URL_IN_DOCKER=http://ai-api:8000
