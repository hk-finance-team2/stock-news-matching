<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.hkteam2.stocknews.stock.StockMapper">

    <!-- StockResponse는 record라서 생성자 순서대로 컬럼을 넣음 -->
    <resultMap id="stockResponse" type="com.hkteam2.stocknews.stock.StockResponse">
        <constructor>
            <arg column="stock_code" javaType="String"/>
            <arg column="stock_name" javaType="String"/>
            <arg column="market" javaType="String"/>
            <arg column="sector" javaType="String"/>
        </constructor>
    </resultMap>

    <!-- 검색 결과 한 건 = StockResponse + matchedTheme (테마로만 찾은 종목이면 그 테마) -->
    <resultMap id="stockSearchResponse" type="com.hkteam2.stocknews.stock.StockSearchResponse">
        <constructor>
            <arg column="stock_code" javaType="String"/>
            <arg column="stock_name" javaType="String"/>
            <arg column="market" javaType="String"/>
            <arg column="sector" javaType="String"/>
            <arg column="matched_theme" javaType="String"/>
        </constructor>
    </resultMap>

    <!--
        검색 조건. keyword가 없으면 조건 없이 전체.
        keyword: 사용자가 친 검색어 그대로 (정렬 비교용)
        likeKeyword: LIKE에서 특수 문자(%, _)를 글자로 취급하도록 바꾼 검색어
        종목명에 들어 있거나, 종목코드가 검색어로 시작하거나, 별칭에 들어 있으면 찾음
    -->
    <!-- 글자로 맞음: 종목명에 들어 있음 / 코드가 검색어로 시작 / 별칭에 들어 있음 -->
    <sql id="textMatch">
        (s.stock_name LIKE CONCAT('%', #{likeKeyword}, '%')
         OR s.stock_code LIKE CONCAT(#{likeKeyword}, '%')
         OR EXISTS (SELECT 1 FROM stock_alias a
                    WHERE a.stock_code = s.stock_code
                      AND a.alias LIKE CONCAT('%', #{likeKeyword}, '%')))
    </sql>

    <!--
        테마로 맞음 (QA #11): 검색어가 테마 이름과 **딱 같을 때만** ("반도체" → 삼성전자·SK하이닉스 등)
        포함(LIKE)으로 하면 "바이"만 쳐도 바이오 160종목이 쏟아져서 딱 맞을 때만
    -->
    <sql id="themeMatch">
        EXISTS (SELECT 1 FROM stock_theme t
                WHERE t.stock_code = s.stock_code
                  AND t.theme = #{keyword})
    </sql>

    <sql id="searchCondition">
        <where>
            <if test="keyword != null">
                <include refid="textMatch"/>
                OR <include refid="themeMatch"/>
            </if>
        </where>
    </sql>

    <select id="countSearch" resultType="long">
        SELECT COUNT(*)
        FROM stock_info s
        <include refid="searchCondition"/>
    </select>

    <!--
        정렬
        1) 순위: 이름이 딱 맞음 → 별칭이 딱 맞음 → 이름이 검색어로 시작 → 코드가 검색어로 시작 → 나머지 글자 → 테마로만 맞음
           (별칭 순위가 없으면 "현대차" 검색에서 이름이 "현대차"로 시작하는 현대차증권이 현대자동차보다 앞에 옴)
        2) 코드로 찾은 것끼리는 코드 순서
        3) 같은 순위 안에서는 최근 7일(mentionFrom 이후) 분석이 끝난 글에 많이 나온 종목부터
           ("삼성" 검색에서 이름 길이가 같은 삼성공조·삼성물산보다 뉴스에 자주 나오는 삼성전자가 앞)
        4) 그다음 이름이 짧은 것부터 (삼성전자가 삼성바이오로직스·삼성스팩10호보다 앞), 그다음 이름순
        글이 없으면 3)은 모두 0이라 예전과 같은 순서
    -->
    <select id="search" resultMap="stockSearchResponse">
        SELECT s.stock_code, s.stock_name, s.market, s.sector,
        <choose>
            <when test="keyword != null">
                CASE WHEN <include refid="textMatch"/> THEN NULL
                     ELSE (SELECT MIN(t.theme) FROM stock_theme t
                           WHERE t.stock_code = s.stock_code AND t.theme = #{keyword})
                END
            </when>
            <otherwise>NULL</otherwise>
        </choose> AS matched_theme
        FROM stock_info s
        <include refid="searchCondition"/>
        ORDER BY
        <if test="keyword != null">
            CASE
                WHEN s.stock_name = #{keyword} THEN 0
                WHEN EXISTS (SELECT 1 FROM stock_alias a
                             WHERE a.stock_code = s.stock_code AND a.alias = #{keyword}) THEN 1
                WHEN s.stock_name LIKE CONCAT(#{likeKeyword}, '%') THEN 2
                WHEN s.stock_code LIKE CONCAT(#{likeKeyword}, '%') THEN 3
                WHEN <include refid="textMatch"/> THEN 4
                <!-- 테마로만 찾은 종목은 맨 뒤. 그 안에서는 아래 최근 언급 순 → 반도체: 삼성전자·SK하이닉스가 앞 -->
                ELSE 5
            END,
            CASE
                WHEN s.stock_name LIKE CONCAT(#{likeKeyword}, '%') THEN NULL
                WHEN s.stock_code LIKE CONCAT(#{likeKeyword}, '%') THEN s.stock_code
            END,
            (SELECT COUNT(*)
             FROM article_stock m
             JOIN article ma ON ma.article_id = m.article_id
             WHERE m.stock_code = s.stock_code
               AND ma.status = 'DONE'
               AND ma.published_at >= #{mentionFrom}) DESC,
            CHAR_LENGTH(s.stock_name),
        </if>
            s.stock_name, s.stock_code
        LIMIT #{limit} OFFSET #{offset}
    </select>

    <select id="findByCode" resultMap="stockResponse">
        SELECT stock_code, stock_name, market, sector
        FROM stock_info
        WHERE stock_code = #{stockCode}
    </select>

    <select id="existsByCode" resultType="boolean">
        SELECT EXISTS (SELECT 1 FROM stock_info WHERE stock_code = #{stockCode})
    </select>

    <resultMap id="stockIssueRow" type="com.hkteam2.stocknews.stock.StockIssueRow">
        <constructor>
            <arg column="stock_code" javaType="String"/>
            <arg column="stock_name" javaType="String"/>
            <arg column="article_count" javaType="_long"/>
            <arg column="avg_relevance" javaType="java.math.BigDecimal"/>
            <arg column="last_published_at" javaType="java.time.LocalDateTime"/>
        </constructor>
    </resultMap>

    <!--
        오늘의 이슈 종목 순위 (F-12): 개표처럼
        ① from(오늘 0시) 이후 분석이 끝난 글만 남기고  ② 종목별로 묶어서(GROUP BY)
        ③ 몇 개 글에 나왔는지 세고(COUNT)  ④ 많은 순 → 평균 관련도 높은 순 → 이름순  ⑤ 위에서 limit개
        article_stock은 (글, 종목)이 한 줄뿐이라 COUNT(*) = 그 종목이 나온 글 수
        AVG는 관련도가 빈(NULL) 줄은 빼고 계산, 전부 비면 NULL → DESC 정렬에서 맨 뒤
    -->
    <select id="findIssues" resultMap="stockIssueRow">
        SELECT s.stock_code, i.stock_name,
               COUNT(*)            AS article_count,
               AVG(s.relevance)    AS avg_relevance,
               MAX(a.published_at) AS last_published_at
        FROM article_stock s
        JOIN article a    ON a.article_id = s.article_id
        JOIN stock_info i ON i.stock_code = s.stock_code
        WHERE a.status = 'DONE'
          AND a.published_at >= #{from}
          <if test="sourceType != null">
              AND a.source_type = #{sourceType}
          </if>
        GROUP BY s.stock_code, i.stock_name
        ORDER BY article_count DESC, avg_relevance DESC, i.stock_name
        LIMIT #{limit}
    </select>

    <resultMap id="stockDailySummaryRow" type="com.hkteam2.stocknews.stock.StockDailySummaryRow">
        <constructor>
            <arg column="news_summary" javaType="String"/>
            <arg column="sns_summary" javaType="String"/>
            <arg column="generated_at" javaType="java.time.LocalDateTime"/>
        </constructor>
    </resultMap>

    <resultMap id="sentimentCountRow" type="com.hkteam2.stocknews.stock.SentimentCountRow">
        <constructor>
            <arg column="sentiment" javaType="String"/>
            <arg column="article_count" javaType="_long"/>
        </constructor>
    </resultMap>

    <!-- 종목의 그날 종합 요약 (AI가 1시간마다 만들어 저장). (종목, 날짜)는 한 줄뿐. 아직 없으면 결과 없음 -->
    <select id="findDailySummary" resultMap="stockDailySummaryRow">
        SELECT news_summary, sns_summary, generated_at
        FROM stock_daily_summary
        WHERE stock_code = #{stockCode} AND summary_date = #{date}
    </select>

    <!--
        감성 비율 재료: from(오늘 0시) 이후 이 종목이 나온 글을 감성별로 묶어서(GROUP BY) 셈
        글 전체 감성(article.sentiment)이 아니라 "이 종목에 대한" 감성(article_stock.sentiment)
        sourceType이 있으면 그 출처(NEWS/SNS) 글만, 없으면 둘 다 (요구사항 기본)
        결과 예: POSITIVE 1, NEUTRAL 1 (0건인 감성은 줄이 안 나옴)
        감성이 NULL(판단 안 함: AI 활용 금지 언론사 기사를 제목만으로 연결한 것)인 줄은 세지 않음
    -->
    <select id="countSentiments" resultMap="sentimentCountRow">
        SELECT s.sentiment, COUNT(*) AS article_count
        FROM article_stock s
        JOIN article a ON a.article_id = s.article_id
        WHERE s.stock_code = #{stockCode}
          AND a.status = 'DONE'
          AND s.sentiment IS NOT NULL   -- 감성을 판단하지 않은 연결(제목만 연결, V12)은 비율에서 뺌
          AND a.published_at >= #{from}
          <if test="sourceType != null">
              AND a.source_type = #{sourceType}
          </if>
        GROUP BY s.sentiment
    </select>

    <resultMap id="mentionCountRow" type="com.hkteam2.stocknews.stock.MentionCountRow">
        <constructor>
            <arg column="bucket" javaType="java.time.LocalDateTime"/>
            <arg column="news_count" javaType="_long"/>
            <arg column="sns_count" javaType="_long"/>
        </constructor>
    </resultMap>

    <!--
        언급량 그래프 (F-14): from ~ to 사이 이 종목이 나온 글을 시간 칸별로 묶어(GROUP BY) 셈
        ① 작성 시각을 칸 이름으로 깎기: HOUR면 08:34 → 08:00, DAY면 11/01 08:04 → 11/01 00:00
        ② 칸마다 뉴스·SNS를 따로 세기: SUM(CASE ...) = "뉴스면 1, 아니면 0"을 더함 (투표함 하나에서 색깔별로 세기)
        글이 있는 칸만 나옴 → 빈 칸(0건)은 Java가 채움
    -->
    <select id="countMentions" resultMap="mentionCountRow">
        SELECT
            <choose>
                <when test="unit == 'HOUR'">
                    CAST(DATE_FORMAT(a.published_at, '%Y-%m-%d %H:00:00') AS DATETIME)
                </when>
                <otherwise>
                    CAST(DATE(a.published_at) AS DATETIME)
                </otherwise>
            </choose> AS bucket,
            SUM(CASE WHEN a.source_type = 'NEWS' THEN 1 ELSE 0 END) AS news_count,
            SUM(CASE WHEN a.source_type = 'SNS' THEN 1 ELSE 0 END) AS sns_count
        FROM article_stock s
        JOIN article a ON a.article_id = s.article_id
        WHERE s.stock_code = #{stockCode}
          AND a.status = 'DONE'
          AND a.published_at &gt;= #{from}
          AND a.published_at &lt; #{to}
        GROUP BY bucket
        ORDER BY bucket
    </select>

</mapper>
