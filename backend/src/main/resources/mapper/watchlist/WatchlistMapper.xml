<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.hkteam2.stocknews.watchlist.WatchlistMapper">

    <!-- WatchlistRow는 record라서 생성자 순서대로 컬럼을 넣음 -->
    <resultMap id="watchlistRow" type="com.hkteam2.stocknews.watchlist.WatchlistRow">
        <constructor>
            <arg column="stock_code" javaType="String"/>
            <arg column="stock_name" javaType="String"/>
            <arg column="market" javaType="String"/>
            <arg column="added_at" javaType="java.time.LocalDateTime"/>
        </constructor>
    </resultMap>

    <!-- 관심 종목(watchlist)과 종목 정보(stock_info)를 이어 붙여 종목명까지 꺼냄 -->
    <sql id="selectRow">
        SELECT w.stock_code, s.stock_name, s.market, w.created_at AS added_at
        FROM watchlist w
        JOIN stock_info s ON s.stock_code = w.stock_code
    </sql>

    <select id="findAllByUserId" resultMap="watchlistRow">
        <include refid="selectRow"/>
        WHERE w.user_id = #{userId}
        ORDER BY w.created_at DESC, w.stock_code
    </select>

    <select id="findOne" resultMap="watchlistRow">
        <include refid="selectRow"/>
        WHERE w.user_id = #{userId}
          AND w.stock_code = #{stockCode}
    </select>

    <select id="exists" resultType="boolean">
        SELECT EXISTS (SELECT 1 FROM watchlist WHERE user_id = #{userId} AND stock_code = #{stockCode})
    </select>

    <insert id="insert">
        INSERT INTO watchlist (user_id, stock_code)
        VALUES (#{userId}, #{stockCode})
    </insert>

    <delete id="delete">
        DELETE FROM watchlist
        WHERE user_id = #{userId}
          AND stock_code = #{stockCode}
    </delete>

</mapper>
